{
  acme_ca https://acme.zerossl.com/v2/DV90
  email anh.bui@sleek.com

  servers :80,:443 {
    protocols h1 h2c h2 h3
  }
  log {
    level INFO
    format json
    output stdout
  }
}

(security_headers) {
    header * {
        Strict-Transport-Security "max-age=3600; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        -Server
        Referrer-Policy strict-origin-when-cross-origin
    }
}

:80, nbvpn.sleek.com:443 {
    import security_headers

    route {
        handle /oauth2-proxy/* {
            reverse_proxy oauth2-proxy:4180
        }
        # relay
        handle /relay* {
            reverse_proxy relay:80
        }
        # Signal
        handle /ws-proxy/signal* {
            reverse_proxy signal:80
        }
        handle /signalexchange.SignalExchange/* {
            reverse_proxy h2c://signal:10000
        }
        # Management
        handle /api/* {
            reverse_proxy management:80
        }
        handle /ws-proxy/management* {
            reverse_proxy management:80
        }
        handle /management.ManagementService/* {
            reverse_proxy h2c://management:80
        }
        handle /oauth2/* {
            reverse_proxy management:80
        }
        # Dashboard (protected)
        handle /* {
            reverse_proxy oauth2-proxy:4180
        }
    }
}
