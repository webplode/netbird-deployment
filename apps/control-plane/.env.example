# Steampipe service. The local service uses trust auth by default.
STEAMPIPE_DATABASE_URL=postgres://steampipe@127.0.0.1:9193/steampipe
STEAMPIPE_STAGING_SCHEMA=aws_staging
STEAMPIPE_PRODUCTION_SCHEMA=aws_production
STEAMPIPE_MONGODB_SCHEMA=mongodbatlas

# Current self-hosted NetBird management endpoint.
NETBIRD_API_URL=https://nbvpn.sleek.com
NETBIRD_API_TOKEN=
NETBIRD_REQUEST_TIMEOUT_MS=15000

# NetBird automatically uses clearly labeled demo data when no token is set.
# Set this explicitly to keep demo mode on even when a token exists.
NETBIRD_DEMO_MODE=false
