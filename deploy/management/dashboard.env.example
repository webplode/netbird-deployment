# Endpoints
NETBIRD_MGMT_API_ENDPOINT=https://nbvpn.sleek.com
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://nbvpn.sleek.com

# Embedded identity provider
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY=https://nbvpn.sleek.com/oauth2
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth

# Dashboard TLS metadata; Caddy terminates public TLS.
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
