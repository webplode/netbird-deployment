# OAuth2-Proxy configuration used by this directory's docker-compose.yml.
OAUTH2_PROXY_OIDC_ISSUER_URL=https://oauth.id.jumpcloud.com/
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# Authenticates the private Caddy /healthz endpoint. Generate with:
# openssl rand -hex 32
NETBIRD_HEALTH_TOKEN=
