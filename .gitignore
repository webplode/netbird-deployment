# Local runtime secrets and generated state. Keep these files on the host only.
.env
.env.*
!.env.example
dashboard.env
management.json
relay.env
turnserver.conf
caddy_data/

# Credential and private-key material must never enter the repository.
*.key
*.pem
*.p12
*.pfx
*.ppk
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*
credentials
credentials.*
*.credentials
*.secret
*.secrets
.envrc
.netrc
.npmrc
.pypirc
.aws/
.ssh/
*.kdbx
*.ovpn
*.kubeconfig
kubeconfig
secrets.json
secrets.yaml
secrets.yml

# Historical captures, backups, editor state, and generated artifacts.
*.bak
*.har

# Local HAR captures and the reports generated from them. Extracted URLs carry
# signed download links, session identifiers, and bearer-token query strings.
har-files/
*.swp
.DS_Store
.omx/
**/__pycache__/
*.py[cod]
psql-test/

# Terraform local state, backend configuration, plans, and populated secret
# material. Keep the provider lock file and tracked *.example templates.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
backend.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
infra/terraform/management-secret.json

# Exit-node stack keeps local state (contains the peer setup key) — never push.
infra/terraform/exit-node/terraform.tfstate
infra/terraform/exit-node/terraform.tfstate.backup
infra/terraform/exit-node/terraform.tfvars
